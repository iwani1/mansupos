# /etc/mansu-platform/platform.env  (chmod 600, owner root)
# NODE_ENV, PORT, PLATFORM_BIND_HOST, PLATFORM_DATA_DIR and PLATFORM_TRUST_PROXY
# are pinned in mansu-platform.service.

# Shops live at <slug>.<base domain>; sign-up and the console at the base domain.
PLATFORM_BASE_DOMAIN=mansupos.com

# 64 hex characters. Encrypts every shop's WooCommerce keys. Generate once:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep a copy OFFLINE: without it, backups of store keys cannot be read.
PLATFORM_MASTER_KEY=

# Pilot: invitation only. Create codes in the console (Invitations) or with
#   npm run platform -- invite-create --email owner@shop.com --discount 50 --months 6
PLATFORM_SIGNUP_MODE=invite
PLATFORM_SIGNUPS_PER_HOUR=10

# Email through Resend (https://resend.com). Verify the sending domain in
# Resend first (SPF + DKIM DNS records), or mail will be refused.
PLATFORM_MAIL_DRIVER=resend
PLATFORM_RESEND_API_KEY=
PLATFORM_MAIL_FROM=Mansu POS <hello@mansupos.com>
PLATFORM_MAIL_REPLY_TO=support@mansupos.com

# Paystack secret key (sk_live_... in production). Set the webhook URL in the
# Paystack dashboard to https://mansupos.com/api/paystack/webhook
PLATFORM_PAYSTACK_SECRET_KEY=
# Only for a staging server using sk_test_ keys:
# PLATFORM_ALLOW_TEST_BILLING=true
PLATFORM_GRACE_DAYS=7

# Daily backup of the registry and every shop, kept 14 days. Copy the backup
# folder off the server too (it is on the same disk).
PLATFORM_BACKUP_HOURS=24
PLATFORM_BACKUP_KEEP_DAYS=14
# PLATFORM_BACKUP_DIR=/var/lib/mansu-platform/backups

# Capacity: shops kept open in memory, and minutes before an idle one closes.
PLATFORM_MAX_OPEN_SHOPS=200
PLATFORM_SHOP_IDLE_MINUTES=20
