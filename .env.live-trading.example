# PRIVATE template for a separate live POS service, NOT the read-only pilot.
# Do not install/start or enter a Read/Write Woo key before the checks in
# docs/LIVE-CASH-ROLLOUT.md. Copy privately on the VPS only after review.
NODE_ENV=production
POS_MODE=live
POS_LIVE_READ_ONLY=false
POS_PUBLIC_ORIGIN=https://pos.mansutrendzgh.com
POS_BIND_HOST=127.0.0.1
PORT=3188
POS_TRUST_PROXY=loopback
POS_DATA_DIR=/var/lib/mansu-pos-live-trading
POS_REQUIRE_SHIFT=true
POS_LOG_LEVEL=info

# Canonical real WooCommerce HTTPS origin; DO NOT use /stagings/.
WOO_BASE_URL=https://mansutrendzgh.com
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# Both real-order gates start OFF and the example unit overrides them OFF.
# A reviewed change to the unit is required for cutover; do not use a staging
# flag to claim acceptance.
POS_ALLOW_LIVE_WRITES=false
POS_OWNER_APPROVAL_REFERENCE=
POS_LIVE_WHOLESALE_APPROVED=false
POS_LIVE_WHOLESALE_ACCEPTANCE_REFERENCE=
POS_STAGING_APPROVED=false
POS_STAGING_WHOLESALE_APPROVED=false

# New owner in this SEPARATE ledger; do not reuse the pilot's ledger/password.
# Replace the temporary secret privately before first start. After changing it
# at first login, remove this bootstrap value and restart only this service.
POS_OWNER_USERNAME=owner
POS_OWNER_PASSWORD=

# Fill only owner-verified business details; test status/fulfilment effects.
POS_BUSINESS_NAME=MansutRENDZGH
POS_BUSINESS_ADDRESS=
POS_BUSINESS_PHONE=
POS_BUSINESS_TAX_ID=
POS_RECEIPT_FOOTER=Thank you for shopping with MansutRENDZGH.
POS_RECEIPT_WIDTH=80
POS_ORDER_STATUS=completed
POS_LOW_STOCK_THRESHOLD=5
POS_SESSION_IDLE_MINUTES=60
POS_RECONCILE_INTERVAL_SECONDS=60
