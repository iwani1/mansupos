{
  "appId": "com.mansutrendzgh.pos.online",
  "productName": "Mansu POS",
  "electronVersion": "45.4.1",
  "asar": true,
  "npmRebuild": false,
  "directories": { "output": "release" },
  "files": ["main.cjs", "policy.cjs", "preload.cjs", "drawer.cjs", "till.json", "picker.html", "picker.js", "picker.css", "picker-preload.cjs", "package.json"],
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "icon": "../assets/mansu.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Mansu POS",
    "artifactName": "Mansu-POS-ONLINE-${version}-Windows-Setup.${ext}"
  }
}
