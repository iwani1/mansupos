# For deploy/mansu-pos-live-pilot.service ONLY. Copy to /etc/mansu-pos-live-pilot/pos.env
# as root:root, mode 0600. Never commit actual keys/passwords or paste them into chat.
NODE_ENV=production
POS_MODE=live
POS_LIVE_READ_ONLY=true
POS_ALLOW_LIVE_WRITES=false
POS_STAGING_APPROVED=false
POS_STAGING_WHOLESALE_APPROVED=false
POS_LIVE_WHOLESALE_APPROVED=false
POS_OWNER_APPROVAL_REFERENCE=
PORT=3187
POS_BIND_HOST=127.0.0.1
POS_DATA_DIR=/var/lib/mansu-pos-live-pilot
POS_TRUST_PROXY=loopback
POS_REQUIRE_SHIFT=false
POS_PUBLIC_ORIGIN=https://pos.mansutrendzgh.com

# Use the canonical HTTPS *origin* of the real store (no path or /wp-admin/).
# If mansutrendzgh.com redirects to www, use https://www.mansutrendzgh.com.
WOO_BASE_URL=https://mansutrendzgh.com
# Create a dedicated WooCommerce REST API key with READ permission only.
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# Separate POS username and a new temporary passphrase >=12 characters.
# After first sign-in/password change, remove POS_OWNER_PASSWORD and restart
# only the pilot service. Do not reuse the WordPress login/password.
POS_OWNER_USERNAME=owner
POS_OWNER_PASSWORD=
POS_LOG_LEVEL=info
