{
  "name": "mansu-pos",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "A WooCommerce-connected point of sale for MansutRENDZGH, with an isolated demo workspace.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node server/index.js",
    "start": "NODE_ENV=production node server/index.js",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs && node tests/browser-recovery.mjs && node tests/browser-preview.mjs && node tests/browser-motion.mjs && node tests/browser-design.mjs && node tests/browser-wholesale.mjs",
    "test:design": "node tests/browser-design.mjs",
    "test:a11y": "node tests/browser-a11y.mjs",
    "backup": "node server/backup.js",
    "restore": "node server/restore.js",
    "preflight": "node server/preflight.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@sparticuz/chromium": "^133.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.14.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "^17.14.0",
    "playwright-core": "^1.51.1",
    "vite": "^6.3.5"
  }
}
