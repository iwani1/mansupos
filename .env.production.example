# Copy to a private server-side .env. Never commit real values or paste them into chat.
NODE_ENV=production
PORT=3000
POS_DATA_DIR=/var/lib/mansu-pos
POS_PUBLIC_ORIGIN=https://pos.your-domain.example
POS_TRUST_PROXY=1
POS_LOG_LEVEL=info

# Start with staging. Live is a separate, later approval gate.
POS_MODE=staging
WOO_BASE_URL=https://staging.your-domain.example
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
POS_STAGING_APPROVED=false

# First owner bootstrap only. The owner must change this temporary password at first sign-in.
POS_OWNER_USERNAME=owner
POS_OWNER_PASSWORD=

# Verified business details only. Leave blank until the owner supplies them.
POS_BUSINESS_NAME=MansutRENDZGH
POS_BUSINESS_ADDRESS=
POS_BUSINESS_PHONE=
POS_BUSINESS_TAX_ID=
POS_RECEIPT_FOOTER=Thank you for shopping with MansutRENDZGH.
POS_RECEIPT_WIDTH=80
POS_ORDER_STATUS=completed
POS_LOW_STOCK_THRESHOLD=5

# Operational safety
POS_REQUIRE_SHIFT=true
POS_SESSION_IDLE_MINUTES=60
POS_RECONCILE_INTERVAL_SECONDS=60

# LIVE only after staging acceptance and written owner approval:
# POS_MODE=live
# WOO_BASE_URL=https://www.mansutrendzgh.com
# POS_ALLOW_LIVE_WRITES=true
# POS_OWNER_APPROVAL_REFERENCE=<written-approval-reference>
