# Staging/trading template: copy to a private server-side .env. Never commit
# real values or paste them into chat. For live catalogue reads WITHOUT checkout,
# use .env.live-pilot.example with deploy/mansu-pos-live-pilot.service instead.
NODE_ENV=production
PORT=3000
# Native systemd staging on a shared Nginx VPS uses PORT=3187 and
# POS_BIND_HOST=127.0.0.1; its service unit enforces these values.
# Docker must listen on 0.0.0.0 INSIDE the container (the host publish is loopback-only).
# POS_BIND_HOST=127.0.0.1
POS_DATA_DIR=/var/lib/mansu-pos
POS_PUBLIC_ORIGIN=https://pos-staging.your-domain.example
POS_TRUST_PROXY=1
POS_LOG_LEVEL=info
# For deploy/docker-compose.existing-proxy.yml ONLY: choose a free localhost
# port on the VPS (not 80/443 or another app's port), e.g. 3187.
POS_HOST_PORT=

# Start with staging. Live is a separate, later approval gate.
POS_MODE=staging
WOO_BASE_URL=https://staging.your-domain.example
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
POS_STAGING_APPROVED=false
# Separate owner approval for isolated staging Wholesale tax/total tests only.
# The legacy trade flag does NOT authorize the replacement Wholesale workflow.
POS_STAGING_WHOLESALE_APPROVED=false

# First owner bootstrap only. The owner must change this temporary password at first sign-in.
POS_OWNER_USERNAME=owner
POS_OWNER_PASSWORD=

# Verified business details only. Leave blank until the owner supplies them.
POS_BUSINESS_NAME=MansutRENDZGH
POS_BUSINESS_ADDRESS=
POS_BUSINESS_PHONE=
POS_BUSINESS_TAX_ID=
POS_RECEIPT_FOOTER=Thank you for shopping with MansutRENDZGH.
POS_RECEIPT_WIDTH=80
POS_ORDER_STATUS=completed
POS_LOW_STOCK_THRESHOLD=5

# Operational safety
POS_REQUIRE_SHIFT=true
POS_SESSION_IDLE_MINUTES=60
POS_RECONCILE_INTERVAL_SECONDS=60

# LIVE only after separately reviewed acceptance and written owner approval.
# If staging is declined, follow docs/LIVE-CASH-ROLLOUT.md first. Do not use the
# read-only pilot service/ledger/key or the port already occupied by it.
# Live POS payments are cash-only; online Paystack checkout is separate.
# POS_MODE=live
# WOO_BASE_URL=https://www.mansutrendzgh.com
# POS_ALLOW_LIVE_WRITES=true
# POS_OWNER_APPROVAL_REFERENCE=<written-approval-reference>
# Wholesale needs distinct written live approval AND a documented live acceptance
# plan/record reference (not a staging flag). Neither value alone proves acceptance.
# POS_LIVE_WHOLESALE_APPROVED=false
# POS_LIVE_WHOLESALE_ACCEPTANCE_REFERENCE=
