# Safe default: isolated local demo; never contacts WooCommerce for checkout.
POS_MODE=demo
PORT=3000
# Native host-Nginx staging only: bind a free private port such as 127.0.0.1:3187.
# Docker still listens on 0.0.0.0 inside the container, published to host loopback.
# POS_BIND_HOST=127.0.0.1
# POS_DATA_DIR=/absolute/private/path

# STAGING: use a separate staging clone, NEVER the production URL.
# POS_MODE=staging
# WOO_BASE_URL=https://YOUR-STAGING-HOST.example
# WOO_CONSUMER_KEY=
# WOO_CONSUMER_SECRET=
# POS_STAGING_APPROVED=false
# Separate owner approval for ISOLATED Wholesale tax/total staging tests.
# Not a claim that acceptance has passed; keep false until authorized for tests.
# Legacy POS_STAGING_TRADE_APPROVED does not enable Wholesale.
# POS_STAGING_WHOLESALE_APPROVED=false

# LIVE CATALOGUE PILOT (no checkout): use .env.live-pilot.example and its
# separately reviewed host-Nginx/systemd service; do not flip this demo to live.
# LIVE TRADING: deliberately requires all retail gates plus separate Wholesale approval after acceptance.
# POS_MODE=live
# WOO_BASE_URL=https://www.mansutrendzgh.com
# WOO_CONSUMER_KEY=
# WOO_CONSUMER_SECRET=
# POS_ALLOW_LIVE_WRITES=false
# POS_OWNER_APPROVAL_REFERENCE=
# Live POS payments are cash-only (even if the browser sends MoMo/card).
# Wholesale remains locked without distinct live owner approval AND a reference
# to the documented live acceptance plan/record; staging flags only apply to staging.
# Neither flag nor reference proves tax/stock tests passed. Legacy trade flags never count.
# POS_LIVE_WHOLESALE_APPROVED=false
# POS_LIVE_WHOLESALE_ACCEPTANCE_REFERENCE=

# Required to bootstrap the first owner in staging/live. No default password.
# Use a unique password of at least 12 characters; never commit this file.
# POS_OWNER_USERNAME=owner
# POS_OWNER_PASSWORD=

# Only verified business information. No address or tax ID is invented.
# POS_RECEIPT_FOOTER=Thank you for shopping with MansutRENDZGH.
# completed = handed over in store; processing = fulfilment still required
POS_ORDER_STATUS=completed
POS_LOW_STOCK_THRESHOLD=5

# Production hardening (see .env.production.example and docs/PRODUCTION.md)
# POS_PUBLIC_ORIGIN=https://pos.your-domain.example
# POS_TRUST_PROXY=1
# POS_REQUIRE_SHIFT=true
# POS_SESSION_IDLE_MINUTES=60
# POS_RECONCILE_INTERVAL_SECONDS=60
# POS_BUSINESS_NAME=MansutRENDZGH
# POS_BUSINESS_ADDRESS=
# POS_BUSINESS_PHONE=
# POS_BUSINESS_TAX_ID=
# POS_RECEIPT_WIDTH=80
